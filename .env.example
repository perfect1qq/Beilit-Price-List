# ===========================================
# Beilit Price List - 前端环境变量配置
# ===========================================
# 复制此文件为 .env 并填入实际值

# API 基础地址 (后端服务地址)
VITE_API_BASE_URL=http://localhost:3001

# 应用标题
VITE_APP_TITLE=Beilit 报价系统

# 是否允许公开注册 (true/false，默认 false)
VITE_ALLOW_PUBLIC_REGISTER=true
